  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([ownerId])
  @@index([previousOwnerId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([spaceId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

