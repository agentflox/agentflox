  @@map("channel_messages")
}

model ChannelMessageAttachment {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  filename  String
  url       String
  mimeType  String         @map("mime_type")
  size      BigInt
  createdAt DateTime       @default(now()) @map("created_at")
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("channel_message_attachments")
}

model ChannelMessageReaction {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  userId    String         @map("user_id")
  emoji     String
  createdAt DateTime       @default(now()) @map("created_at")
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User           @relation("ChannelMessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("channel_message_reactions")
}

model WorkspaceActivity {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  userId      String?          @map("user_id")
  memberId    String?          @map("member_id")
  action      ActivityAction
  entityType  String           @map("entity_type")
  entityId    String           @map("entity_id")
  metadata    Json?
  ipAddress   String?          @map("ip_address")
  userAgent   String?          @map("user_agent")
  createdAt   DateTime         @default(now()) @map("created_at")
  member      WorkspaceMember? @relation(fields: [memberId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("workspace_activities")
}

model TaskActivity {
  id        String       @id @default(cuid())
  taskId    String       @map("task_id")
  userId    String       @map("user_id")
  action    TaskAction
  field     String?
  oldValue  Json?        @map("old_value")
  newValue  Json?        @map("new_value")
  commentId String?      @map("comment_id")
  createdAt DateTime     @default(now()) @map("created_at")
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   TaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([commentId])
  @@index([createdAt])
  @@map("task_activities")
}

model WorkspaceAnalytics {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  date             DateTime  @db.Date
  activeUsers      Int       @default(0) @map("active_users")
  tasksCreated     Int       @default(0) @map("tasks_created")
  tasksCompleted   Int       @default(0) @map("tasks_completed")
  messagesCount    Int       @default(0) @map("messages_count")
  documentsCreated Int       @default(0) @map("documents_created")
  totalTimeTracked Int       @default(0) @map("total_time_tracked")
  createdAt        DateTime  @default(now()) @map("created_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([date])
  @@map("workspace_analytics")
}

model Automation {
  id             String                 @id @default(cuid())
  workspaceId    String?                @map("workspace_id")
  ownerId        String                 @map("owner_id")
  name           String
  description    String?
  status         AutomationEntityStatus @default(ACTIVE)
  conditions     Json?
  actions        Json
  isActive       Boolean                @default(true) @map("is_active")
  runCount       Int                    @default(0) @map("run_count")
  lastRanAt      DateTime?              @map("last_ran_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  agentId        String?                @map("agent_id") @db.Uuid
  cronExpression String?                @map("cron_expression")
  isScheduled    Boolean                @default(false) @map("is_scheduled")
  projectId      String?                @map("project_id")
  spaceId        String?                @map("space_id")
  teamId         String?                @map("team_id")
  timezone       String?                @default("UTC")
  logs           AutomationLog[]
  triggers       AutomationTrigger[]
  aiAgent        AiAgent?               @relation(fields: [agentId], references: [id])
  projects       Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spaces         Space?                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  teams          Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace      Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User                   @relation("AutomationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([isActive])
  @@index([status])
  @@index([ownerId])
  @@index([agentId])
  @@index([projectId])
  @@index([spaceId])
  @@index([teamId])
  @@map("automations")
}

model AutomationTrigger {
  id              String                @id @default(cuid())
  automationId    String                @map("automation_id")
  triggerType     AutomationTriggerType @map("trigger_type")
  triggerConfig   Json                  @map("trigger_config")
  name            String?
  description     String?
  isActive        Boolean               @default(true) @map("is_active")
  priority        Int                   @default(0)
  conditions      Json?
  filters         Json?
  metadata        Json?
  tags            String[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  activatedAt     DateTime?             @map("activated_at")
  deactivatedAt   DateTime?             @map("deactivated_at")
  lastTriggeredAt DateTime?             @map("last_triggered_at")
  triggerCount    Int                   @default(0) @map("trigger_count")
  automation      Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([triggerType])
  @@index([isActive])
  @@index([priority])
  @@index([lastTriggeredAt])
  @@map("automation_triggers")
}

model UserLike {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  targetUserId String   @map("target_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  targetUser   User     @relation("UserLikesReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  user         User     @relation("UserLikesGiven", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
  @@index([targetUserId])
  @@map("user_likes")
}

model UserComment {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  targetUserId String   @map("target_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  content      String
  targetUser   User     @relation("UserCommentsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  user         User     @relation("UserCommentsGiven", fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("user_comments")
}

model MarketplaceService {
  id          String             @id @default(cuid())
  title       String
  description String
  provider    String
  price       Float
  currency    String             @default("USD")
  category    String
  icon        String
  isActive    Boolean            @default(true)
  orders      MarketplaceOrder[]

  @@map("marketplace_services")
}

model MarketplaceOrder {
  id             String              @id @default(cuid())
  serviceId      String              @map("service_id")
  projectId      String              @map("project_id")
  buyerId        String              @map("buyer_id")
  status         String              @default("PENDING")
  creditAmount   Int
  stripeIntentId String?             @map("stripe_intent_id")
  listingId      String?             @map("listing_id")
  createdAt      DateTime            @default(now())
  buyer          User                @relation(fields: [buyerId], references: [id])
  project        Project             @relation(fields: [projectId], references: [id])
  service        MarketplaceService  @relation(fields: [serviceId], references: [id])
  listing        MarketplaceListing? @relation("listingOrders", fields: [listingId], references: [id])

  @@map("marketplace_orders")
}

model MarketplaceApplication {
  id                 String             @id @default(cuid())
  listingId          String             @map("listing_id")
  applicantId        String             @map("applicant_id")
  pitch              String
  targetRate         String?            @map("target_rate")
  estimatedDuration  String?            @map("estimated_duration")
  proposalText       String?            @map("proposal_text")
  answers            Json?
  provisioningStatus String             @default("pending") @map("provisioning_status")
  createdAt          DateTime           @default(now())
  applicant          User               @relation("marketplaceApplications", fields: [applicantId], references: [id])
  listing            MarketplaceListing @relation("listingApplications", fields: [listingId], references: [id])

  @@map("marketplace_applications")
}

/// A published item in the marketplace (template, agent, tool, task, talent, team, project).
model MarketplaceListing {
  // ─── Identity ───────────────────────────────────────────────────────────────
  id            String         @id @default(cuid())
  conversations Conversation[]
  slug          String         @unique // SEO-friendly URL slug
  type          ListingType
  status        ListingStatus  @default(DRAFT)

  // ─── Content ────────────────────────────────────────────────────────────────
  title            String
  shortDesc        String?  @map("short_desc") // ~160 char tagline for cards
  description      String // Rich markdown/HTML body
  changelog        String? // Markdown release notes
  coverImage       String?  @map("cover_image")
  previewImages    String[] @default([]) @map("preview_images")
  demoUrl          String?  @map("demo_url")
  repoUrl          String?  @map("repo_url")
  documentationUrl String?  @map("documentation_url")

  // ─── Classification ─────────────────────────────────────────────────────────
  categories        String[] @default([])
  tags              String[] @default([])
  industry          String[] @default([])
  intent            String?  @map("intent")
  applicationSchema Json?    @map("application_schema")

  // ─── Authorship ─────────────────────────────────────────────────────────────
  authorId String @map("author_id")

  // ─── Pricing ────────────────────────────────────────────────────────────────
  isFree       Boolean            @default(true) @map("is_free")
  priceCredits Int?               @map("price_credits") // credits if asset type 
  price        Int?               @map("price") // price if non-asset type
  pricingModel String?            @map("pricing_model") // "one_time"|"subscription"|"usage"
  licenseType  ListingLicenseType @default(PROPRIETARY) @map("license_type")
  priceMin     Int?               @map("price_min") // for talent/task types
  priceMax     Int?               @map("price_max")
  currency     String?            @map("currency")

  // ─── Discovery flags ────────────────────────────────────────────────────────
  isRemote       Boolean   @default(false) @map("is_remote")
  location       String?
  isFeatured     Boolean   @default(false) @map("is_featured")
  isVerified     Boolean   @default(false) @map("is_verified") // staff/badge verified
  isBoosted      Boolean   @default(false) @map("is_boosted") // paid promotion
  boostExpiresAt DateTime? @map("boost_expires_at")

  // ─── Versioning ─────────────────────────────────────────────────────────────
  version         String? @default("1.0.0")
  latestVersionId String? @map("latest_version_id") // FK resolved in versions relation

  // ─── Permissions ────────────────────────────────────────────────────────────
  allowClone         Boolean @default(true) @map("allow_clone")
  allowFork          Boolean @default(false) @map("allow_fork")
  allowRepublish     Boolean @default(false) @map("allow_republish")
  requireAttribution Boolean @default(true) @map("require_attribution")

  // ─── Counters (denormalised for fast reads) ──────────────────────────────────
  viewCount     Int   @default(0) @map("view_count")
  likeCount     Int   @default(0) @map("like_count")
  commentCount  Int   @default(0) @map("comment_count")
  downloadCount Int   @default(0) @map("download_count")
  cloneCount    Int   @default(0) @map("clone_count")
  installCount  Int   @default(0) @map("install_count")
  orderCount    Int   @default(0) @map("order_count")
  // Rating counters
  ratingAvg     Float @default(0) @map("rating_avg") // 0.0 – 5.0
  ratingCount   Int   @default(0) @map("rating_count")
  rating1Count  Int   @default(0) @map("rating_1_count") // histogram buckets
  rating2Count  Int   @default(0) @map("rating_2_count")
  rating3Count  Int   @default(0) @map("rating_3_count")
  rating4Count  Int   @default(0) @map("rating_4_count")
  rating5Count  Int   @default(0) @map("rating_5_count")

  // ─── Timestamps ─────────────────────────────────────────────────────────────
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  publishedAt    DateTime? @map("published_at")
  featuredAt     DateTime? @map("featured_at")
  archivedAt     DateTime? @map("archived_at")
  lastActivityAt DateTime? @map("last_activity_at")

  // ─── Relations ──────────────────────────────────────────────────────────────
  author       User                     @relation("marketplaceListings", fields: [authorId], references: [id])
  applications MarketplaceApplication[] @relation("listingApplications")
  orders       MarketplaceOrder[]       @relation("listingOrders")
  earnings     Earning[]                @relation("listingEarnings")
  ratings      ListingRating[]          @relation("listingRatings")
  comments     ListingComment[]         @relation("listingComments")
  likes        ListingLike[]            @relation("listingLikes")
  downloads    ListingDownload[]        @relation("listingDownloads")
  versions     ListingVersion[]         @relation("listingVersions")

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  // ─── Indexes ────────────────────────────────────────────────────────────────
  @@index([slug])
  @@index([type, status])
  @@index([authorId])
  @@index([isFeatured, status])
  @@index([isBoosted, boostExpiresAt])
  @@index([ratingAvg, ratingCount])
  @@index([downloadCount])
  @@index([likeCount])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("marketplace_listings")
}

// ───────────────────────────────────────────────────────────────────────────────
// Listing Rating  (one per user per listing, with vote-on-review support)
// ───────────────────────────────────────────────────────────────────────────────

/// A star rating (1–5) with an optional written review left by a buyer.
model ListingRating {
  id                 String                  @id @default(cuid())
  listingId          String                  @map("listing_id")
  userId             String                  @map("user_id")
  // Rating core
  rating             Int // 1 – 5
  title              String? // review headline
  body               String? // full review body
  // Quality signals
  isVerifiedPurchase Boolean                 @default(false) @map("is_verified_purchase")
  helpfulCount       Int                     @default(0) @map("helpful_count") // number of "helpful" votes
  notHelpfulCount    Int                     @default(0) @map("not_helpful_count")
  // Moderation
  moderationStatus   ListingModerationStatus @default(APPROVED) @map("moderation_status")
  moderatedBy        String?                 @map("moderated_by")
  moderatedAt        DateTime?               @map("moderated_at")
  moderationNote     String?                 @map("moderation_note")
  // Edit tracking
  isEdited           Boolean                 @default(false) @map("is_edited")
  editedAt           DateTime?               @map("edited_at")
  // Timestamps
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  listing   MarketplaceListing  @relation("listingRatings", fields: [listingId], references: [id], onDelete: Cascade)
  user      User                @relation("listingRatingsGiven", fields: [userId], references: [id], onDelete: Cascade)
  moderator User?               @relation("listingRatingsModerator", fields: [moderatedBy], references: [id])
  votes     ListingRatingVote[] @relation("ratingVotes")

  @@unique([listingId, userId]) // one rating per user per listing
  @@index([listingId, moderationStatus])
  @@index([userId])
  @@index([rating])
  @@index([helpfulCount])
  @@index([createdAt])
  @@map("listing_ratings")
}

/// Helpful / not-helpful vote on a review (like Amazon reviews).
model ListingRatingVote {
  id        String   @id @default(cuid())
  ratingId  String   @map("rating_id")
  userId    String   @map("user_id")
  isHelpful Boolean  @map("is_helpful") // true = helpful, false = not helpful
  createdAt DateTime @default(now()) @map("created_at")

  rating ListingRating @relation("ratingVotes", fields: [ratingId], references: [id], onDelete: Cascade)
  user   User          @relation("listingRatingVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ratingId, userId])
  @@index([userId])
  @@map("listing_rating_votes")
}

// ───────────────────────────────────────────────────────────────────────────────
// Listing Comment  (mirrors Post → PostComment → PostCommentVote pattern)
// ───────────────────────────────────────────────────────────────────────────────

/// Threaded comment + Q&A on a marketplace listing.
model ListingComment {
  id            String               @id @default(cuid())
  listingId     String               @map("listing_id")
  userId        String               @map("user_id")
  parentId      String?              @map("parent_id") // null = top-level thread
  content       String
  // Vote tallies (denormalised for fast display)
  upvotes       Int                  @default(0)
  downvotes     Int                  @default(0)
  // Metadata
  isPinned      Boolean              @default(false) @map("is_pinned") // author/staff can pin
  isAuthorReply Boolean              @default(false) @map("is_author_reply") // listing author reply
  isEdited      Boolean              @default(false) @map("is_edited")
  editedAt      DateTime?            @map("edited_at")
  // Soft-delete
  deletedAt     DateTime?            @map("deleted_at") // null = live
  deletedBy     String?              @map("deleted_by")
  // Moderation
  status        ListingCommentStatus @default(VISIBLE)
  moderatedBy   String?              @map("moderated_by")
  moderatedAt   DateTime?            @map("moderated_at")
  // Timestamps
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  listing   MarketplaceListing   @relation("listingComments", fields: [listingId], references: [id], onDelete: Cascade)
  user      User                 @relation("listingCommentsGiven", fields: [userId], references: [id], onDelete: Cascade)
  moderator User?                @relation("listingCommentsModerator", fields: [moderatedBy], references: [id])
  parent    ListingComment?      @relation("ListingCommentReplies", fields: [parentId], references: [id])
  replies   ListingComment[]     @relation("ListingCommentReplies")
  votes     ListingCommentVote[] @relation("commentVotes")

  @@index([listingId, status])
  @@index([listingId, parentId])
  @@index([userId])
  @@index([parentId])
  @@index([isPinned])
  @@index([createdAt])
  @@map("listing_comments")
}

/// Up/down vote on a listing comment (mirrors PostCommentVote).
model ListingCommentVote {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  voteType  VoteType @map("vote_type") // reuses existing UPVOTE | DOWNVOTE enum
  createdAt DateTime @default(now()) @map("created_at")

  comment ListingComment @relation("commentVotes", fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation("listingCommentVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("listing_comment_votes")
}

// ───────────────────────────────────────────────────────────────────────────────
// Listing Like  (mirrors PostLike)
// ───────────────────────────────────────────────────────────────────────────────

/// A user "liking" / saving a listing (also acts as wishlist).
model ListingLike {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing MarketplaceListing @relation("listingLikes", fields: [listingId], references: [id], onDelete: Cascade)
  user    User               @relation("listingLikesGiven", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("listing_likes")
}

// ───────────────────────────────────────────────────────────────────────────────
// Listing Download / Clone  (audit trail + counter source-of-truth)
// ───────────────────────────────────────────────────────────────────────────────

/// Records every download, clone, or install event for audit and analytics.
model ListingDownload {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  userId    String?  @map("user_id") // null = anonymous
  versionId String?  @map("version_id")
  // Event kind: "download", "clone", "install", "fork"
  eventType String   @default("download") @map("event_type")
  isPaid    Boolean  @default(false) @map("is_paid") // credits exchanged?
  orderId   String?  @map("order_id") // FK to MarketplaceOrder if paid
  // Request metadata
  ipHash    String?  @map("ip_hash") // hashed IP for abuse detection
  userAgent String?  @map("user_agent")
  country   String? // ISO 3166-1 alpha-2
  createdAt DateTime @default(now()) @map("created_at")

  listing MarketplaceListing @relation("listingDownloads", fields: [listingId], references: [id], onDelete: Cascade)
  user    User?              @relation("listingDownloadsUser", fields: [userId], references: [id])
  version ListingVersion?    @relation("versionDownloads", fields: [versionId], references: [id])

  @@index([listingId, eventType])
  @@index([userId])
  @@index([createdAt])
  @@index([country])
  @@map("listing_downloads")
}

// ───────────────────────────────────────────────────────────────────────────────
// Listing Version  (full changelog + file snapshots per semver)
// ───────────────────────────────────────────────────────────────────────────────

/// Immutable semantic version snapshot of a listing's published artifact.
model ListingVersion {
  id              String    @id @default(cuid())
  listingId       String    @map("listing_id")
  authorId        String    @map("author_id")
  version         String // semver string e.g. "2.3.1"
  changelog       String? // release notes for this version
  artifactUrl     String?   @map("artifact_url") // downloadable asset URL
  artifactSize    Int?      @map("artifact_size") // bytes
  artifactHash    String?   @map("artifact_hash") // SHA-256 for integrity
  metadata        Json? // arbitrary version-specific metadata
  isLatest        Boolean   @default(false) @map("is_latest")
  isDeprecated    Boolean   @default(false) @map("is_deprecated")
  deprecatedAt    DateTime? @map("deprecated_at")
  deprecationNote String?   @map("deprecation_note")
  downloadCount   Int       @default(0) @map("download_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  listing   MarketplaceListing @relation("listingVersions", fields: [listingId], references: [id], onDelete: Cascade)
  author    User               @relation("listingVersionsUser", fields: [authorId], references: [id])
  downloads ListingDownload[]  @relation("versionDownloads")

  @@unique([listingId, version])
  @@index([listingId, isLatest])
  @@index([authorId])
  @@index([createdAt])
  @@map("listing_versions")
}

model Earning {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  listingId     String?  @map("listing_id")
  amountCredits Int      @map("amount_credits")
  reason        String // e.g. "Asset Sale", "Task Completion"
  status        String   @default("CLEARED") // "PENDING", "CLEARED"
  createdAt     DateTime @default(now()) @map("created_at")

  user    User                @relation("userEarnings", fields: [userId], references: [id])
  listing MarketplaceListing? @relation("listingEarnings", fields: [listingId], references: [id])

  @@map("earnings")
}

model Project {
  id                 String                 @id @default(cuid())
  workspaceId        String?                @map("workspace_id")
  organizationId     String?                @map("organization_id")
  ownerId            String                 @map("owner_id")
  previousOwnerId    String?                @map("previous_owner_id")
  name               String
  description        String
  logo               String?
  icon               String?
  color              String?
  tags               String[]
  status             ProjectStatus          @default(DRAFT)
  isActive           Boolean                @default(true) @map("is_active")
  visibility         Visibility             @default(ADMINS)
  isPublic           Boolean                @default(true) @map("is_public")
  embedding          Unsupported("vector")?
  embeddingUpdatedAt DateTime?              @map("embedding_updated_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  launchedAt         DateTime?              @map("launched_at")
  transferredAt      DateTime?              @map("transferred_at")
  spaceId            String?                @map("space_id")

  activityLogs       ActivityLog[]
