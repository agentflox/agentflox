  members            ProjectMember[]
  ownershipTransfers ProjectOwnershipTransfer[] @relation("ProjectTransfers")
  teams              ProjectTeam[]

  // Owner: restrict deletion — a User cannot be hard-deleted while they own a
  // Project. Force a transfer (see ProjectOwnershipTransfer) or anonymize the
  // User row instead. See note below on why this isn't Cascade.
  owner User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Previous owner: now a real relation instead of a bare string, so it's
  // queryable and referentially safe. SetNull on delete — losing the
  // historical "previous owner" link is fine, it's not authoritative
  // (ProjectOwnershipTransfer is the source of truth for history).
  previousOwner User? @relation("ProjectPreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)

  space                   Space?                   @relation(fields: [spaceId], references: [id])
  workspace               Workspace?               @relation(fields: [workspaceId], references: [id])
  organization            Organization?            @relation(fields: [organizationId], references: [id])
