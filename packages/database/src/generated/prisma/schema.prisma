model ProjectOwnershipTransfer {
  id          String @id @default(cuid())
  projectId   String @map("project_id")
  fromOwnerId String @map("from_owner_id")
  toOwnerId   String @map("to_owner_id")

  // Who actually triggered this transfer. Usually == fromOwnerId, but not
  // always — an admin can force a transfer during offboarding, abuse
  // handling, or dispute resolution, and that shouldn't be indistinguishable
  // from a normal owner-initiated transfer.
  requestedBy String @map("requested_by")

  reason             String?
  notes              String?
  status             TransferStatus @default(PENDING)
  requestedAt        DateTime       @default(now()) @map("requested_at")
  acceptedAt         DateTime?      @map("accepted_at")
  rejectedAt         DateTime?      @map("rejected_at")
  cancelledAt        DateTime?      @map("cancelled_at")
  completedAt        DateTime?      @map("completed_at")
  requiresAcceptance Boolean        @default(true) @map("requires_acceptance")

  // Store a hash, never the raw token. Compare by hashing the incoming
  // token from the accept-link and looking up the hash.
  acceptanceTokenHash String?   @unique @map("acceptance_token_hash")
  expiresAt           DateTime? @map("expires_at")
  metadata            Json?

  fromOwner User    @relation("TransferFrom", fields: [fromOwnerId], references: [id])
  toOwner   User    @relation("TransferTo", fields: [toOwnerId], references: [id])
  requester User    @relation("TransferRequestedBy", fields: [requestedBy], references: [id])
  project   Project @relation("ProjectTransfers", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fromOwnerId])
  @@index([toOwnerId])
  @@index([requestedBy])
  @@index([status])
  // Partial unique index enforcing "at most one PENDING transfer per
  // project" — added via raw SQL in the migration, Prisma has no native
  // syntax for a filtered unique index:
  //
  //   CREATE UNIQUE INDEX one_pending_transfer_per_project
  //   ON project_ownership_transfers (project_id)
  //   WHERE status = 'PENDING';
  @@map("project_ownership_transfers")
}

