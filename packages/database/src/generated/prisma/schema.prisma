generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                             String                      @id @default(cuid())
  email                          String                      @unique
  emailVerified                  DateTime?                   @map("email_verified")
  name                           String?
  image                          String?
  password                       String?
  firstName                      String?                     @map("first_name")
  lastName                       String?                     @map("last_name")
  username                       String?                     @unique
  avatar                         String?
  linkedinUrl                    String?                     @map("linkedin_url")
  twitterUrl                     String?                     @map("twitter_url")
  facebookUrl                    String?                     @map("facebook_url")
  instagramUrl                   String?                     @map("instagram_url")
  headline                       String?
  bio                            String?
  phone                          String?
  website                        String?
  location                       String?
  timezone                       String?                     @default("UTC")
  isActive                       Boolean                     @default(true) @map("is_active")
  isVerified                     Boolean                     @default(false) @map("is_verified")
  onboardingCompleted            Boolean                     @default(false) @map("onboarding_completed")
  onboardingStep                 Int                         @default(0) @map("onboarding_step")
  role                           String?
  usagePurpose                   String?                     @map("usage_purpose")
  managementGoals                String[]                    @map("management_goals")
  referralSource                 String?                     @map("referral_source")
  credibilityScore               Float                       @default(0) @map("credibility_score")
  verificationLevel              VerificationLevel           @default(UNVERIFIED) @map("verification_level")
  isKycVerified                  Boolean                     @default(false) @map("is_kyc_verified")
  kycDocuments                   String[]                    @map("kyc_documents")
  createdAt                      DateTime                    @default(now()) @map("created_at")
  updatedAt                      DateTime                    @updatedAt @map("updated_at")
  lastActiveAt                   DateTime?                   @map("last_active_at")
  embedding                      Unsupported("vector")?
  embeddingUpdatedAt             DateTime?                   @map("embedding_updated_at")
  accounts                       Account[]
  integrationConnections         IntegrationConnection[]
  activityLogs                   ActivityLog[]
  agentAuditLogs                 AgentAuditLog[]
  agentCollaborators             AgentCollaborator[]
  ownedAiAgents                  AiAgent[]                   @relation("AiAgentOwner")
  aiConversationFeedback         AiConversationFeedback[]
  sharedConversations            AiConversationShare[]       @relation("SharedBy")
  receivedConversations          AiConversationShare[]       @relation("SharedWith")
  aiConversations                AiConversation[]
  messageAnnotations             AiMessageAnnotation[]
  aiMessageFeedback              AiMessageFeedback[]
  aiUsageLogs                    AiUsageLog[]
  customAiModels                 AiModel[]                   @relation("UserCustomAiModels")
  automationsCreated             Automation[]                @relation("AutomationOwner")
  channelMemberships             ChannelMember[]
  channelMessages                ChannelMessage[]
  channelsCreated                Channel[]
  checklistAssignments           ChecklistItem[]
  compositeTools                 CompositeTool[]
  receivedConnections            Connection[]                @relation("ConnectionReceiver")
  connections                    Connection[]                @relation("ConnectionRequester")
  creditPurchases                CreditPurchase[]            @relation("userCreditPurchases")
  customRolesCreated             CustomRole[]                @relation("CustomRoleCreator")
  dashboardsCreated              Dashboard[]
  discounts                      DiscountToUser[]            @relation("userDiscounts")
  documentCollaborations         DocumentCollaborator[]
  documentVersions               DocumentVersion[]
  ownedDocuments                 Document[]                  @relation("DocumentOwner")
  previouslyOwnedDocuments       Document[]                  @relation("DocumentPreviousOwner")
  documentTransfersFrom          DocumentOwnershipTransfer[] @relation("DocumentTransferFrom")
  documentTransfersTo            DocumentOwnershipTransfer[] @relation("DocumentTransferTo")
  documentTransfersRequested     DocumentOwnershipTransfer[] @relation("DocumentTransferRequestedBy")
  receivedInvitations            Invitation[]                @relation("InvitationReceiver")
  sentInvitations                Invitation[]                @relation("InvitationSender")
  permissionsGranted             LocationPermission[]        @relation("PermissionGranter")
  locationPermissions            LocationPermission[]        @relation("UserLocationPermissions")
  marketplaceOrders              MarketplaceOrder[]
  marketplaceApplications        MarketplaceApplication[]    @relation("marketplaceApplications")
  marketplaceListings            MarketplaceListing[]        @relation("marketplaceListings")
  earnings                       Earning[]                   @relation("userEarnings")
  executionLogs                  ExecutionLog[]
  listingRatings                 ListingRating[]             @relation("listingRatingsGiven")
  listingRatingsModerator        ListingRating[]             @relation("listingRatingsModerator")
  listingRatingVotes             ListingRatingVote[]         @relation("listingRatingVotes")
  listingComments                ListingComment[]            @relation("listingCommentsGiven")
  listingCommentsModerator       ListingComment[]            @relation("listingCommentsModerator")
  listingCommentVotes            ListingCommentVote[]        @relation("listingCommentVotes")
  listingLikes                   ListingLike[]               @relation("listingLikesGiven")
  listingDownloads               ListingDownload[]           @relation("listingDownloadsUser")
  listingVersions                ListingVersion[]            @relation("listingVersionsUser")
  receivedMessages               Message[]                   @relation("MessageReceiver")
  sentMessages                   Message[]                   @relation("MessageSender")
  notifications                  Notification[]
  organizationMemberships        OrganizationMember[]
  ownedOrganizations             Organization[]              @relation("OrganizationOwner")
  payments                       Payment[]                   @relation("userPayments")
  payouts                        Payout[]                    @relation("UserPayouts")
  cancelledPermissionInvitations PermissionInvitation[]      @relation("InvitationCanceller")
  sentPermissionInvitations      PermissionInvitation[]      @relation("InvitationSender")
  receivedPermissionInvitations  PermissionInvitation[]      @relation("InvitationRecipient")
  postCommentVotes               PostCommentVote[]
  postComments                   PostComment[]
  postLikes                      PostLike[]
  postShares                     PostShare[]
  postBookmarks                  PostBookmark[]
  postFollows                    PostFollow[]
  postReports                    PostReport[]
  posts                          Post[]
  projectComments                ProjectComment[]            @relation("ProjectCommentAuthor")
  communityGroupsOwned           CommunityGroup[]            @relation("CommunityGroupOwner")
  communityGroupMemberships      CommunityGroupMember[]
  communityGroupBansReceived     CommunityGroupBan[]         @relation("CommunityGroupBanUser")
  communityGroupBansIssued       CommunityGroupBan[]         @relation("CommunityGroupBanActor")
  communityGroupAppeals          CommunityGroupAppeal[]      @relation("CommunityGroupAppealUser")
  communityGroupAppealReviewed   CommunityGroupAppeal[]      @relation("CommunityGroupAppealReviewer")
  blockedUsers                   ProjectBlockedMember[]      @relation("BlockerUser")
  blockedFromProjects            ProjectBlockedMember[]      @relation("BlockedUser")
  participatedProjects           ProjectMember[]
  transfersFrom                  ProjectOwnershipTransfer[]  @relation("TransferFrom")
  transfersTo                    ProjectOwnershipTransfer[]  @relation("TransferTo")
  projectTransfersRequested      ProjectOwnershipTransfer[]  @relation("TransferRequestedBy")
  ownedProjects                  Project[]                   @relation("ProjectOwner")
  previouslyOwnedProjects        Project[]                   @relation("ProjectPreviousOwner")
  promotions                     PromotionToUser[]           @relation("userPromotions")
  publicLinksCreated             PublicLink[]                @relation("PublicLinkCreator")
  receivedRequests               Request[]                   @relation("RequestReceiver")
  sentRequests                   Request[]                   @relation("RequestSender")
  givenReviews                   Review[]                    @relation("ReviewGiver")
  receivedReviews                Review[]                    @relation("ReviewReceiver")
  sessions                       Session[]
  subscriptions                  Subscription[]              @relation("userSubscriptions")
  taskActivities                 TaskActivity[]
  taskAssignees                  TaskAssignee[]              @relation("TaskAssigneesUser")
  taskAttachments                TaskAttachment[]
  taskLinks                      TaskLink[]
  taskComments                   TaskComment[]
  taskCommentReactions           TaskCommentReaction[]       @relation("TaskCommentReactionUser")

  taskWatchers                TaskWatcher[]
  documentWatchers            DocumentWatcher[]
  tasksCreated                Task[]                       @relation("TaskCreator")
  teamMemberships             TeamMember[]                 @relation("TeamMemberUser")
  ownedTeams                  Team[]                       @relation("TeamOwner")
  previouslyOwnedTeams        Team[]                       @relation("TeamPreviousOwner")
  teamTransfersFrom           TeamOwnershipTransfer[]      @relation("TeamTransferFrom")
  teamTransfersTo             TeamOwnershipTransfer[]      @relation("TeamTransferTo")
  teamTransfersRequested      TeamOwnershipTransfer[]      @relation("TeamTransferRequestedBy")
  templatesCreated            Template[]
  templateVersions            TemplateVersion[]
  templateAuditLogs           TemplateAuditLog[]
  timeEntries                 TimeEntry[]
  ownedTools                  Tool[]                       @relation("ToolOwner")
  usages                      Usage[]                      @relation("userUsages")
  activities                  UserActivity[]
  commentsReceived            UserComment[]                @relation("UserCommentsReceived")
  commentsGiven               UserComment[]                @relation("UserCommentsGiven")
  interests                   UserInterest[]
  likesReceived               UserLike[]                   @relation("UserLikesReceived")
  likesGiven                  UserLike[]                   @relation("UserLikesGiven")
  quota                       UserQuota?
  settings                    UserSettings?
  vectorEmbeddings            VectorEmbedding[]
  verificationRequests        VerificationRequest[]
  viewShares                  ViewShare[]
  webhooksCreated             Webhook[]
  workspaceActivities         WorkspaceActivity[]
  invitedGuests               WorkspaceGuest[]             @relation("GuestInviter")
  guestMemberships            WorkspaceGuest[]             @relation("UserGuestWorkspaces")
  workspaceMemberships        WorkspaceMember[]            @relation("WorkspaceMemberUser")
  ownedWorkspaces             Workspace[]                  @relation("WorkspaceOwner")
  previouslyOwnedWorkspaces   Workspace[]                  @relation("WorkspacePreviousOwner")
  workspaceTransfersFrom      WorkspaceOwnershipTransfer[] @relation("WorkspaceTransferFrom")
  workspaceTransfersTo        WorkspaceOwnershipTransfer[] @relation("WorkspaceTransferTo")
  workspaceTransfersRequested WorkspaceOwnershipTransfer[] @relation("WorkspaceTransferRequestedBy")
  ownedSpaces                 Space[]                      @relation("SpaceOwner")
  spaceMemberships            SpaceMember[]                @relation("SpaceMemberUser")
  previouslyOwnedSpaces       Space[]                      @relation("SpacePreviousOwner")
  spaceTransfersFrom          SpaceOwnershipTransfer[]     @relation("SpaceTransferFrom")
  spaceTransfersTo            SpaceOwnershipTransfer[]     @relation("SpaceTransferTo")
  spaceTransfersRequested     SpaceOwnershipTransfer[]     @relation("SpaceTransferRequestedBy")
  ownedFolders                Folder[]                     @relation("FolderOwner")
  previouslyOwnedFolders      Folder[]                     @relation("FolderPreviousOwner")
  folderTransfersFrom         FolderOwnershipTransfer[]    @relation("FolderTransferFrom")
  folderTransfersTo           FolderOwnershipTransfer[]    @relation("FolderTransferTo")
  folderTransfersRequested    FolderOwnershipTransfer[]    @relation("FolderTransferRequestedBy")
  ownedLists                  List[]                       @relation("ListOwner")
  previouslyOwnedLists        List[]                       @relation("ListPreviousOwner")
  listTransfersFrom           ListOwnershipTransfer[]      @relation("ListTransferFrom")
  listTransfersTo             ListOwnershipTransfer[]      @relation("ListTransferTo")
  listTransfersRequested      ListOwnershipTransfer[]      @relation("ListTransferRequestedBy")
  ownedViews                  View[]                       @relation("ViewOwner")
  previouslyOwnedViews        View[]                       @relation("ViewPreviousOwner")
  viewTransfersFrom           ViewOwnershipTransfer[]      @relation("ViewTransferFrom")
  viewTransfersTo             ViewOwnershipTransfer[]      @relation("ViewTransferTo")
  viewTransfersRequested      ViewOwnershipTransfer[]      @relation("ViewTransferRequestedBy")
  listsCreated                List[]                       @relation("ListCreator")

  ownedWorkforces Workforce[]     @relation("WorkforceOwner")
  agentFeedbacks  AgentFeedback[]

  customFieldsCreated            CustomField[]            @relation("CustomFieldCreator")
  taskCustomRelationshipsCreated TaskCustomRelationship[] @relation("TaskCustomRelationshipCreator")

  documentComments         DocumentComment[]         @relation("DocumentCommentAuthor")
  documentCommentsAssigned DocumentComment[]         @relation("DocumentCommentAssignee")
  documentCommentsResolved DocumentComment[]         @relation("DocumentCommentResolver")
  documentCommentReactions DocumentCommentReaction[] @relation("DocCommentReactions")

  channelMessagesAssigned ChannelMessage[]         @relation("ChannelMessageAssignee")
  channelMessagesResolved ChannelMessage[]         @relation("ChannelMessageResolver")
  channelMessageReactions ChannelMessageReaction[] @relation("ChannelMessageReactions")

  reportedBugs           BugReport[]              @relation("ReportedBugs")
  assignedBugs           BugReport[]              @relation("AssignedBugs")
  bugReportAttachments   BugReportAttachment[]
  bugReportComments      BugReportComment[]
  bugReportStatusChanges BugReportStatusHistory[]

  toolVersionsCreated CompositeToolVersion[]
  toolExecutions      CompositeToolExecutionLog[]

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([deletedAt])
  @@index([isActive])
  @@index([isActive, deletedAt])
  @@index([role])
  @@index([verificationLevel])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([isVerified])
  @@map("users")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  ownerId     String               @map("owner_id")
  logo        String?
  domain      String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  description String?
  website     String?
  socialLinks Json?
  aiAgents    AiAgent[]
  members     OrganizationMember[]
  owner       User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  projects    Project[]
  teams       Team[]
  workspaces  Workspace[]
  templates   Template[]

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Workspace {
  id                      String                       @id @default(cuid())
  ownerId                 String                       @map("owner_id")
  previousOwnerId         String?                      @map("previous_owner_id")
  name                    String
  description             String?
  status                  WorkspaceStatus              @default(ACTIVE)
  isActive                Boolean                      @default(true) @map("is_active")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  transferredAt           DateTime?                    @map("transferred_at")
  archivedAt              DateTime?                    @map("archived_at")
  avatar                  String?
  icon                    String?
  color                   String?                      @default("#3B82F6")
  organizationId          String?                      @map("organization_id")
  visibility              Visibility                   @default(PRIVATE)
  embedding               Unsupported("vector")?
  embeddingUpdatedAt      DateTime?                    @map("embedding_updated_at")
  isArchived              Boolean                      @default(false) @map("is_archived")
  memberLimit             Int?                         @map("member_limit")
  settings                Json?
  slug                    String?                      @unique
  storageLimit            BigInt?                      @map("storage_limit")
  storageUsed             BigInt                       @default(0) @map("storage_used")
  aiAgents                AiAgent[]
  agentWorkflows          AgentWorkflow[]
  aiConversations         AiConversation[]             @relation("WorkspaceConversations")
  automations             Automation[]
  channels                Channel[]
  compositeTools          CompositeTool[]
  customFields            CustomField[]
  customRoles             CustomRole[]                 @relation("WorkspaceCustomRoles")
  dashboards              Dashboard[]
  documents               Document[]
  folders                 Folder[]
  integrations            Integration[]
  lists                   List[]
  permissionInvitations   PermissionInvitation[]       @relation("WorkspaceInvitations")
  projects                Project[]
  publicLinks             PublicLink[]                 @relation("WorkspacePublicLinks")
  spaces                  Space[]
  taskStatuses            TaskStatus[]
  taskTypes               TaskType[]
  tasks                   Task[]
  teams                   Team[]
  templates               Template[]
  tools                   Tool[]
  views                   View[]
  webhooks                Webhook[]
  activityLogs            WorkspaceActivity[]
  analytics               WorkspaceAnalytics[]
  permissionGuests        WorkspaceGuest[]             @relation("WorkspaceGuests")
  invitations             WorkspaceInvitation[]
  members                 WorkspaceMember[]
  ownershipTransfers      WorkspaceOwnershipTransfer[] @relation("WorkspaceTransfers")
  organization            Organization?                @relation(fields: [organizationId], references: [id])
  taskCustomRelationships TaskCustomRelationship[]

  // Owner: restrict deletion — a User cannot be hard-deleted while they own a
  // Workspace. Force a transfer (see WorkspaceOwnershipTransfer) or anonymize
  // the User row instead.
  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Previous owner: queryable historical link. SetNull on delete — losing the
  // link is fine; WorkspaceOwnershipTransfer is the source of truth for history.
  previousOwner  User?       @relation("WorkspacePreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)
  workforces     Workforce[]
  customAiModels AiModel[]   @relation("WorkspaceCustomAiModels")

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([ownerId])
  @@index([previousOwnerId])
  @@index([organizationId])
  @@index([slug])
  @@index([status])
  @@index([isActive, isArchived])
  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id                   String              @id @default(cuid())
  workspaceId          String              @map("workspace_id")
  userId               String              @map("user_id")
  canCreateSpaces      Boolean             @default(false) @map("can_create_spaces")
  canInvite            Boolean             @default(false) @map("can_invite")
  canManageBilling     Boolean             @default(false) @map("can_manage_billing")
  customization        Json?
  invitedBy            String?             @map("invited_by")
  joinedAt             DateTime            @default(now()) @map("joined_at")
  lastActiveAt         DateTime?           @map("last_active_at")
  leftAt               DateTime?           @map("left_at")
  notificationSettings Json?               @map("notification_settings")
  permissions          Json?
  status               MemberStatus        @default(ACTIVE)
  role                 WorkspaceRole       @default(MEMBER)
  customRoleId         String?             @map("custom_role_id")
  activities           WorkspaceActivity[]
  customRole           CustomRole?         @relation("MemberCustomRole", fields: [customRoleId], references: [id])
  user                 User                @relation("WorkspaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([status])
  @@index([role])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  invitedBy   String        @map("invited_by")
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model WorkspaceOwnershipTransfer {
  id                  String         @id @default(cuid())
  workspaceId         String?        @map("workspace_id")
  fromOwnerId         String         @map("from_owner_id")
  toOwnerId           String         @map("to_owner_id")
  requestedBy         String         @map("requested_by")
  reason              String?
  notes               String?
  status              TransferStatus @default(PENDING)
  requestedAt         DateTime       @default(now()) @map("requested_at")
  acceptedAt          DateTime?      @map("accepted_at")
  rejectedAt          DateTime?      @map("rejected_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  completedAt         DateTime?      @map("completed_at")
  requiresAcceptance  Boolean        @default(true) @map("requires_acceptance")
  acceptanceTokenHash String?        @unique @map("acceptance_token_hash")
  expiresAt           DateTime?      @map("expires_at")
  metadata            Json?

  fromOwner User       @relation("WorkspaceTransferFrom", fields: [fromOwnerId], references: [id])
  toOwner   User       @relation("WorkspaceTransferTo", fields: [toOwnerId], references: [id])
  requester User       @relation("WorkspaceTransferRequestedBy", fields: [requestedBy], references: [id])
  workspace Workspace? @relation("WorkspaceTransfers", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([fromOwnerId])
  @@index([toOwnerId])
  @@index([requestedBy])
  @@index([status])
  // Partial unique index enforcing "at most one PENDING transfer per
  // workspace" — added via raw SQL in the migration:
  //
  //   CREATE UNIQUE INDEX one_pending_transfer_per_workspace
  //   ON workspace_ownership_transfers (workspace_id)
  //   WHERE status = 'PENDING';
  @@map("workspace_ownership_transfers")
}

model Space {
  id                 String                   @id @default(cuid())
  workspaceId        String?                  @map("workspace_id")
  ownerId            String                   @map("owner_id")
  previousOwnerId    String?                  @map("previous_owner_id")
  name               String
  description        String?
  status             SpaceStatus              @default(ACTIVE)
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  transferredAt      DateTime?                @map("transferred_at")
  embedding          Unsupported("vector")?
  embeddingUpdatedAt DateTime?                @map("embedding_updated_at")
  icon               String?
  color              String?
  visibility         Visibility               @default(ADMINS)
  settings           Json?
  aiAgents           AiAgent[]
  aiConversations    AiConversation[]         @relation("SpaceConversations")
  channels           Channel[]
  automations        Automation[]
  compositeTools     CompositeTool[]
  customFields       CustomField[]
  folders            Folder[]
  lists              List[]
  projects           Project[]
  members            SpaceMember[]
  ownershipTransfers SpaceOwnershipTransfer[] @relation("SpaceTransfers")
  workspace          Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Owner: restrict deletion — a User cannot be hard-deleted while they own a
  // Space. Force a transfer (see SpaceOwnershipTransfer) or anonymize the
  // User row instead.
  owner User @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Previous owner: queryable historical link. SetNull on delete — losing the
  // link is fine; SpaceOwnershipTransfer is the source of truth for history.
  previousOwner           User?                    @relation("SpacePreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)
  taskStatuses            TaskStatus[]
  taskTypes               TaskType[]
  tasks                   Task[]
  teams                   Team[]
  tools                   Tool[]
  views                   View[]
  workforces              Workforce[]
  documents               Document[]
  taskCustomRelationships TaskCustomRelationship[]

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([workspaceId])
  @@index([ownerId])
  @@index([previousOwnerId])
  @@index([status])
  @@index([isActive])
  @@map("spaces")
}

model SpaceOwnershipTransfer {
  id                  String         @id @default(cuid())
  spaceId             String         @map("space_id")
  fromOwnerId         String         @map("from_owner_id")
  toOwnerId           String         @map("to_owner_id")
  requestedBy         String         @map("requested_by")
  reason              String?
  notes               String?
  status              TransferStatus @default(PENDING)
  requestedAt         DateTime       @default(now()) @map("requested_at")
  acceptedAt          DateTime?      @map("accepted_at")
  rejectedAt          DateTime?      @map("rejected_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  completedAt         DateTime?      @map("completed_at")
  requiresAcceptance  Boolean        @default(true) @map("requires_acceptance")
  acceptanceTokenHash String?        @unique @map("acceptance_token_hash")
  expiresAt           DateTime?      @map("expires_at")
  metadata            Json?

  fromOwner User  @relation("SpaceTransferFrom", fields: [fromOwnerId], references: [id])
  toOwner   User  @relation("SpaceTransferTo", fields: [toOwnerId], references: [id])
  requester User  @relation("SpaceTransferRequestedBy", fields: [requestedBy], references: [id])
  space     Space @relation("SpaceTransfers", fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([fromOwnerId])
  @@index([toOwnerId])
  @@index([requestedBy])
  @@index([status])
  // Partial unique index enforcing "at most one PENDING transfer per
  // space" — added via raw SQL in the migration:
  //
  //   CREATE UNIQUE INDEX one_pending_transfer_per_space
  //   ON space_ownership_transfers (space_id)
  //   WHERE status = 'PENDING';
  @@map("space_ownership_transfers")
}

model Integration {
  id          String              @id @default(cuid())
  workspaceId String?             @map("workspace_id")
  provider    IntegrationProvider
  config      Json
  credentials String?             @map("encrypted_credentials")
  isActive    Boolean             @default(true) @map("is_active")
  installedBy String              @map("installed_by")
  installedAt DateTime            @default(now()) @map("installed_at")
  lastSyncAt  DateTime?           @map("last_sync_at")
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([provider])
  @@map("integrations")
}

/// OAuth connections for integrations (separate from NextAuth login Account rows).
model IntegrationConnection {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  /// Catalog provider id: github, slack, google_mail, google_calendar, google_drive
  provider          String
  providerAccountId String   @map("provider_account_id")
  accessToken       String?  @map("access_token")
  refreshToken      String?  @map("refresh_token")
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  displayName       String?  @map("display_name")
  email             String?
  avatarUrl         String?  @map("avatar_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerAccountId])
  @@index([userId, provider])
  @@map("integration_connections")
}

model AutomationLog {
  id              String           @id @default(cuid())
  automationId    String           @map("automation_id")
  status          AutomationStatus
  triggerData     Json             @map("trigger_data")
  actionsExecuted Json             @map("actions_executed")
  error           String?
  executedAt      DateTime         @default(now()) @map("executed_at")
  automation      Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([executedAt])
  @@map("automation_logs")
}

model Task {
  id                  String             @id @default(cuid())
  workspaceId         String?            @map("workspace_id")
  channelId           String?            @map("channel_id")
  projectId           String?            @map("project_id")
  teamId              String?            @map("team_id")
  title               String
  description         String?
  assigneeId          String?            @map("assignee_id")
  createdBy           String             @map("created_by")
  visibility          Visibility         @default(ADMINS)
  icon                String?
  coverImage          String?            @map("cover_image")
  isPublic            Boolean            @default(false) @map("is_public")
  priority            TaskPriority       @default(NORMAL)
  taskTypeId          String?            @map("task_type_id")
  startDate           DateTime?          @map("start_date")
  dueDate             DateTime?          @map("due_date")
  noStartTime         Boolean            @default(false) @map("no_start_time")
  noEndTime           Boolean            @default(false) @map("no_end_time")
  timeEstimate        Int?               @map("time_estimate")
  isStarred           Boolean            @default(false) @map("is_starred")
  tags                String[]           @default([])
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  position            String             @default("a0")
  listId              String?            @map("list_id")
  statusId            String?            @map("status_id")
  spaceId             String?            @map("space_id")
  parentId            String?            @map("parent_id")
  order               String             @default("a0")
  aiConversations     AiConversation[]
  checklists          Checklist[]
  customFieldValues   CustomFieldValue[]
  activities          TaskActivity[]
  assignees           TaskAssignee[]     @relation("TaskAssignees")
  attachments         TaskAttachment[]
  taskLinks           TaskLink[]
  comments            TaskComment[]
  blockedDependencies TaskDependency[]   @relation("BlockingTask")
  dependencies        TaskDependency[]   @relation("DependentTask")
  locationType        LocationType       @default(WORKSPACE) @map("location_type")
  watchers            TaskWatcher[]
  channel             Channel?           @relation(fields: [channelId], references: [id])
  creator             User               @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  list                List?              @relation(fields: [listId], references: [id])
  tasks               Task?              @relation("tasksTotasks", fields: [parentId], references: [id], onDelete: Cascade)
  other_tasks         Task[]             @relation("tasksTotasks")
  project             Project?           @relation(fields: [projectId], references: [id])
  space               Space?             @relation(fields: [spaceId], references: [id])
  status              TaskStatus?        @relation(fields: [statusId], references: [id])
  taskType            TaskType?          @relation(fields: [taskTypeId], references: [id])
  team                Team?              @relation(fields: [teamId], references: [id])
  workspace           Workspace?         @relation(fields: [workspaceId], references: [id])
  timeEntries         TimeEntry[]

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  sharedLists List[] @relation("TaskSharedLists")

  @@index([workspaceId])
  @@index([listId])
  @@index([statusId])
  @@index([channelId])
  @@index([projectId])
  @@index([teamId])
  @@index([createdBy])
  @@index([assigneeId])
  @@index([parentId])
  @@index([parentId, order])
  @@map("tasks")
}

model TaskType {
  id          String     @id @default(cuid())
  workspaceId String?    @map("workspace_id")
  spaceId     String?    @map("space_id")
  projectId   String?    @map("project_id")
  teamId      String?    @map("team_id")
  folderId    String?    @map("folder_id")
  listId      String?    @map("list_id")
  name        String
  description String?
  icon        String?
  color       String?
  isDefault   Boolean    @default(false) @map("is_default")
  isActive    Boolean    @default(true) @map("is_active")
  position    Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  folder      Folder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  list        List?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  space       Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([teamId])
  @@map("task_types")
}

model TaskStatus {
  id          String     @id @default(cuid())
  listId      String?    @map("list_id")
  workspaceId String?    @map("workspace_id")
  spaceId     String?    @map("space_id")
  projectId   String?    @map("project_id")
  teamId      String?    @map("team_id")
  folderId    String?    @map("folder_id")
  isSystem    Boolean    @default(false) @map("is_system")
  name        String
  color       String     @default("#94A3B8")
  position    Int        @default(0)
  type        StatusType @default(CUSTOM)
  createdAt   DateTime   @default(now()) @map("created_at")
  folder      Folder?    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  list        List?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  space       Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([listId])
  @@index([folderId])
  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([teamId])
  @@index([isSystem])
  @@map("task_statuses")
}

model TaskCustomRelationship {
  id                 String  @id @default(cuid())
  workspaceId        String? @map("workspace_id")
  name               String
  relatedTo          String  @default("specific") // 'any', 'specific'
  relatedListId      String? @map("related_list_id")
  createRollupFields Boolean @default(false) @map("create_rollup_fields")
  description        String?
  permissionLevel    String  @default("workspace") @map("permission_level") // 'workspace', 'anyone_edit', 'anyone_set', 'anyone_view', 'private'
  customPermissions  Json?   @map("custom_permissions") // Exceptions array
  isRequired         Boolean @default(false) @map("is_required")
  isVisibleToGuests  Boolean @default(true) @map("is_visible_to_guests")

  // Context (Belongs to)
  spaceId   String? @map("space_id")
  projectId String? @map("project_id")
  teamId    String? @map("team_id")
  folderId  String? @map("folder_id")
  listId    String? @map("list_id")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator   User       @relation("TaskCustomRelationshipCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      List?      @relation("RelatedList", fields: [relatedListId], references: [id], onDelete: SetNull)

  // Belongs to relations
  space       Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  contextList List?    @relation("ContextList", fields: [listId], references: [id], onDelete: Cascade)

  dependencies TaskDependency[]

  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([teamId])
  @@index([folderId])
  @@index([listId])
  @@index([createdBy])
  @@map("task_custom_relationships")
}

model TaskDependency {
  id                   String                  @id @default(cuid())
  taskId               String                  @map("task_id")
  dependsOnId          String                  @map("depends_on_id")
  type                 DependencyType          @default(FINISH_TO_START)
  customRelationshipId String?                 @map("custom_relationship_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  dependsOn            Task                    @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  task                 Task                    @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  customRelationship   TaskCustomRelationship? @relation(fields: [customRelationshipId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
  @@index([customRelationshipId])
  @@map("task_dependencies")
}

model TaskAssignee {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  userId      String?  @map("user_id")
  teamId      String?  @map("team_id")
  agentId     String?  @map("agent_id") @db.Uuid
  assigned_at DateTime @default(now())
  assigned_by String?
  aiAgent     AiAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task        Task     @relation("TaskAssignees", fields: [taskId], references: [id], onDelete: Cascade)
  team        Team?    @relation("TaskAssigneesTeam", fields: [teamId], references: [id], onDelete: Cascade)
  user        User?    @relation("TaskAssigneesUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@unique([taskId, agentId])
  @@unique([taskId, teamId])
  @@index([userId])
  @@index([taskId])
  @@index([agentId])
  @@index([teamId])
  @@map("task_assignees")
}

model TaskWatcher {
  id      String   @id @default(cuid())
  taskId  String   @map("task_id")
  userId  String   @map("user_id")
  addedAt DateTime @default(now()) @map("added_at")
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

model TaskComment {
  id         String                @id @default(cuid())
  taskId     String                @map("task_id")
  userId     String                @map("user_id")
  parentId   String?               @map("parent_id")
  content    String
  isEdited   Boolean               @default(false) @map("is_edited")
  editedAt   DateTime?             @map("edited_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  parent     TaskComment?          @relation("CommentReplies", fields: [parentId], references: [id])
  replies    TaskComment[]         @relation("CommentReplies")
  task       Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions  TaskCommentReaction[]
  activities TaskActivity[]

  @@index([taskId])
  @@index([userId])
  @@index([parentId])
  @@map("task_comments")
}

model TaskCommentReaction {
  id        String      @id @default(cuid())
  commentId String      @map("comment_id")
  userId    String      @map("user_id")
  emoji     String
  createdAt DateTime    @default(now()) @map("created_at")
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation("TaskCommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("task_comment_reactions")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String   @map("task_id")
  uploadedBy String   @map("uploaded_by")
  filename   String
  url        String
  size       BigInt
  mimeType   String   @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

model TaskLink {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  createdBy   String   @map("created_by")
  url         String
  title       String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_links")
}

model Checklist {
  id        String          @id @default(cuid())
  taskId    String          @map("task_id")
  name      String
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  items     ChecklistItem[]
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String    @map("checklist_id")
  name        String
  isCompleted Boolean   @default(false) @map("is_completed")
  position    Int       @default(0)
  assigneeId  String?   @map("assignee_id")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  duration    Int
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  isRunning   Boolean   @default(false) @map("is_running")
  billable    Boolean   @default(false)
  hourlyRate  Float?    @map("hourly_rate")
  createdAt   DateTime  @default(now()) @map("created_at")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([startTime])
  @@map("time_entries")
}

model CustomField {
  id                String             @id @default(cuid())
  workspaceId       String?            @map("workspace_id")
  name              String
  type              CustomFieldType
  locationType      LocationType       @default(PERSONAL) @map("location_type")
  permissionLevel   String             @default("workspace") @map("permission_level")
  customPermissions Json?              @map("custom_permissions")
  config            Json?
  defaultValue      Json?              @map("default_value")
  isRequired        Boolean            @default(false) @map("is_required")
  position          Int                @default(0)
  applyTo           CustomFieldScope[] @map("apply_to")
  createdAt         DateTime           @default(now()) @map("created_at")
  createdBy         String?            @map("created_by")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  folderId          String?            @map("folder_id")
  listId            String?            @map("list_id")
  projectId         String?            @map("project_id")
  spaceId           String?            @map("space_id")
  teamId            String?            @map("team_id")

  // Additional settings
  inheritedFrom     String?               @map("inherited_from")
  isPinned          Boolean               @default(false) @map("is_pinned")
  isRequiredInTasks Boolean               @default(false) @map("is_required_in_tasks")
  visibility        Visibility            @default(ADMINS)
  isVisibleToGuests Boolean               @default(true) @map("is_visible_to_guests")
  values            CustomFieldValue[]
  locations         CustomFieldLocation[]
  creator           User?                 @relation("CustomFieldCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  folder            Folder?               @relation(fields: [folderId], references: [id], onDelete: Cascade)
  list              List?                 @relation(fields: [listId], references: [id], onDelete: Cascade)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  space             Space?                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  team              Team?                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace         Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([teamId])
  @@index([folderId])
  @@index([listId])
  @@index([createdBy])
  @@map("custom_fields")
}

model CustomFieldLocation {
  id            String @id @default(cuid())
  customFieldId String @map("custom_field_id")

  workspaceId  String?      @map("workspace_id")
  spaceId      String?      @map("space_id")
  projectId    String?      @map("project_id")
  folderId     String?      @map("folder_id")
  listId       String?      @map("list_id")
  teamId       String?      @map("team_id")
  locationType LocationType @map("location_type")

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([customFieldId])
  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([folderId])
  @@index([listId])
  @@index([teamId])
  @@map("custom_field_locations")
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String      @map("custom_field_id")
  taskId        String?     @map("task_id")
  value         Json
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  task          Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([customFieldId])
  @@index([taskId])
  @@map("custom_field_values")
}

model SpaceMember {
  id          String    @id @default(cuid())
  spaceId     String    @map("space_id")
  userId      String    @map("user_id")
  role        SpaceRole @default(MEMBER)
  permissions Json?
  addedAt     DateTime  @default(now()) @map("added_at")
  isHidden    Boolean   @default(false)
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user        User      @relation("SpaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model Folder {
  id                 String                    @id @default(cuid())
  workspaceId        String?                   @map("workspace_id")
  spaceId            String?                   @map("space_id")
  projectId          String?                   @map("project_id")
  teamId             String?                   @map("team_id")
  ownerId            String                    @map("owner_id")
  previousOwnerId    String?                   @map("previous_owner_id")
  parentId           String?                   @map("parent_id")
  name               String
  description        String?
  status             FolderStatus              @default(ACTIVE)
  visibility         Visibility                @default(ADMINS)
  color              String?
  icon               String?
  position           Int                       @default(0)
  isArchived         Boolean                   @default(false) @map("is_archived")
  settings           Json?
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  transferredAt      DateTime?                 @map("transferred_at")
  archivedAt         DateTime?                 @map("archived_at")
  aiConversations    AiConversation[]
  customFields       CustomField[]
  parent             Folder?                   @relation("FolderHierarchy", fields: [parentId], references: [id])
  children           Folder[]                  @relation("FolderHierarchy")
  ownershipTransfers FolderOwnershipTransfer[] @relation("FolderTransfers")
  project            Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  space              Space?                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  team               Team?                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace          Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Owner: restrict deletion — a User cannot be hard-deleted while they own a
  // Folder. Force a transfer (see FolderOwnershipTransfer) or anonymize the
  // User row instead.
  owner User @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Previous owner: queryable historical link. SetNull on delete — losing the
  // link is fine; FolderOwnershipTransfer is the source of truth for history.
  previousOwner           User?                    @relation("FolderPreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)
  lists                   List[]
  taskStatuses            TaskStatus[]
  taskTypes               TaskType[]
  views                   View[]
  documents               Document[]
  taskCustomRelationships TaskCustomRelationship[]

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([teamId])
  @@index([parentId])
  @@index([ownerId])
  @@index([previousOwnerId])
  @@index([status])
  @@index([isArchived])
  @@index([deletedAt])
  @@map("folders")
}

model FolderOwnershipTransfer {
  id                  String         @id @default(cuid())
  folderId            String         @map("folder_id")
  fromOwnerId         String         @map("from_owner_id")
  toOwnerId           String         @map("to_owner_id")
  requestedBy         String         @map("requested_by")
  reason              String?
  notes               String?
  status              TransferStatus @default(PENDING)
  requestedAt         DateTime       @default(now()) @map("requested_at")
  acceptedAt          DateTime?      @map("accepted_at")
  rejectedAt          DateTime?      @map("rejected_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  completedAt         DateTime?      @map("completed_at")
  requiresAcceptance  Boolean        @default(true) @map("requires_acceptance")
  acceptanceTokenHash String?        @unique @map("acceptance_token_hash")
  expiresAt           DateTime?      @map("expires_at")
  metadata            Json?

  fromOwner User   @relation("FolderTransferFrom", fields: [fromOwnerId], references: [id])
  toOwner   User   @relation("FolderTransferTo", fields: [toOwnerId], references: [id])
  requester User   @relation("FolderTransferRequestedBy", fields: [requestedBy], references: [id])
  folder    Folder @relation("FolderTransfers", fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([fromOwnerId])
  @@index([toOwnerId])
  @@index([requestedBy])
  @@index([status])
  // Partial unique index enforcing "at most one PENDING transfer per
  // folder" — added via raw SQL in the migration:
  //
  //   CREATE UNIQUE INDEX one_pending_transfer_per_folder
  //   ON folder_ownership_transfers (folder_id)
  //   WHERE status = 'PENDING';
  @@map("folder_ownership_transfers")
}

model List {
  id                 String                  @id @default(cuid())
  workspaceId        String?                 @map("workspace_id")
