// ─────────────────────────────────────────────
// TEMPLATE SYSTEM
// ─────────────────────────────────────────────

/// The canonical template record. Stores the serialised snapshot (`content`)
/// of any supported entity type (space, folder, list, task, doc, view, agent,
/// workforce, proposal) together with all configuration, sharing rules, tags,
/// custom fields, and version history.
model Template {
  id             String  @id @default(cuid())
  /// Null = global / system-level template (not bound to any workspace).
  workspaceId    String? @map("workspace_id")
  /// Org-level scope: visible to all workspaces in this organisation.
  organizationId String? @map("organization_id")
  createdBy      String  @map("created_by")

  // ── Identity ──────────────────────────────
  name        String
  description String?
  icon        String?
  coverImage  String?  @map("cover_image")
  color       String?
  tags        String[] @default([])

  // ── Classification ────────────────────────
  category   String?
  entityType TemplateEntityType  @map("entity_type")
  complexity TemplateComplexity? @map("complexity")

  // ── Source tracking ───────────────────────
  /// The type of the entity this template was captured from.
  sourceEntityType TemplateEntityType? @map("source_entity_type")
  /// The ID of the original entity this template was captured from.
  sourceEntityId   String?             @map("source_entity_id")

  // ── Captured snapshot ─────────────────────
  /// Full serialised content of the source entity (JSON).
  content Json

  // ── What is included in the snapshot ──────
  /// Which child entity types are bundled into this template
  /// (e.g. a SPACE template may include FOLDER + LIST children).
  includedEntityTypes TemplateEntityType[] @default([]) @map("included_entity_types")

  /// Entity-agnostic capture configuration stored as a JSON object.
  /// Each entity type defines its own relevant keys; unrecognised keys are ignored.
  ///
  /// Common keys (apply to most entity types):
  ///   statuses, customFields, views, automations, attachments,
  ///   assignees, dates, comments, relationships, permissions
  ///
  /// Task-specific:    subtasks, checklists, timeLogs, dependencies, watchers
  /// List/Folder:      nestedFolders, nestedLists, tasks
  /// Space:            members, settings
  /// Doc:              versions, collaborators, embeds
  /// View:             filters, grouping, sorting, columns
  /// Agent:            triggers, memory, tools, knowledgeBase, outputSchema
  /// Workforce:        graph, swarmConfig, agentAssignments
  /// Proposal:         budget, timeline, attachments, contact
  captureConfig Json? @map("capture_config")

  // ── Visibility & sharing ──────────────────
  /// Same `Visibility` enum as tasks/spaces/agents. Optional user/team allowlist when `visibility` is PRIVATE (custom share).
  visibility   Visibility @default(PRIVATE)
  shareUserIds String[]   @default([]) @map("share_user_ids")
  shareTeamIds String[]   @default([]) @map("share_team_ids")
  isPublic     Boolean    @default(false) @map("is_public")
  isFeatured   Boolean    @default(false) @map("is_featured")
  isArchived   Boolean    @default(false) @map("is_archived")
  /// True for templates shipped with the platform (cannot be deleted by users).
  isSystem     Boolean    @default(false) @map("is_system")

  // ── Usage metrics ─────────────────────────
  useCount  Int @default(0) @map("use_count")
  viewCount Int @default(0) @map("view_count")

  // ── Versioning ────────────────────────────
  version Int @default(1)

  // ── Timestamps ────────────────────────────
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")
  publishedAt DateTime? @map("published_at")

  // ── Relations ─────────────────────────────
  creator      User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  auditLogs TemplateAuditLog[]
  versions  TemplateVersion[]

  // --- soft delete fields ---
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([workspaceId])
  @@index([organizationId])
  @@index([createdBy])
  @@index([entityType])
  @@index([category])
  @@index([isPublic, isFeatured])
  @@index([isSystem])
  @@index([isArchived])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("templates")
}

/// Immutable version snapshot created every time a template is updated.
model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String   @map("template_id")
  version     Int
  name        String
  description String?
  content     Json
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  changeNote  String?  @map("change_note")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

/// Full audit trail for every significant template event (apply, merge,
/// update, share, publish, archive …).
model TemplateAuditLog {
  id         String             @id @default(cuid())
  templateId String             @map("template_id")
  actorId    String             @map("actor_id")
  event      TemplateAuditEvent

  // ── Where was the template applied / merged to? ──
  targetEntityType TemplateEntityType? @map("target_entity_type")
  targetEntityId   String?             @map("target_entity_id")
  targetEntityName String?             @map("target_entity_name")

  // ── Result of the operation ───────────────────────
  status       TemplateAuditStatus @default(SUCCESS)
  errorMessage String?             @map("error_message")

  // ── Rich metadata (diff, options used, etc.) ─────
  metadata Json?
  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")

  createdAt DateTime @default(now()) @map("created_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id])

  @@index([templateId])
  @@index([actorId])
  @@index([event])
  @@index([targetEntityType, targetEntityId])
  @@index([createdAt])
  @@map("template_audit_logs")
}

model BugReport {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Global entity reference – links a report to any entity in the platform
  entityType String? @map("entity_type") // "tool" | "agent" | "workspace" | "task" | "marketplace" | "platform"
  entityId   String? @map("entity_id")

  // Report content
  title            String
  description      String
  stepsToReproduce String?          @map("steps_to_reproduce")
  expectedBehavior String?          @map("expected_behavior")
  actualBehavior   String?          @map("actual_behavior")
  reproducibility  Reproducibility?

  // Classification
  category BugReportCategory
  severity BugReportSeverity @default(MEDIUM)
  priority BugReportPriority @default(NORMAL)
  status   BugReportStatus   @default(OPEN)
  tags     String[]          @default([])

  // Automatically captured context
  pageUrl    String? @map("page_url")
  region     String?
  locale     String?
  userAgent  String? @map("user_agent")
  appVersion String? @map("app_version")
  os         String?
  deviceType String? @map("device_type")

  // Admin / support resolution fields
  assignedToId String?   @map("assigned_to_id")
  resolution   String?
  resolvedAt   DateTime? @map("resolved_at")
  closedAt     DateTime? @map("closed_at")
  adminNotes   String?   @map("admin_notes")

  // Duplicate tracking & external issue linking
  duplicateOfId String? @map("duplicate_of_id")
  externalRef   String? @map("external_ref") // e.g. "GH-123", "JIRA-456"

  // Lifecycle
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user       User  @relation("ReportedBugs", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedBugs", fields: [assignedToId], references: [id], onDelete: SetNull)

  duplicateOf BugReport?  @relation("DuplicateReports", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  BugReport[] @relation("DuplicateReports")

  attachments BugReportAttachment[]
  comments    BugReportComment[]
  statusLog   BugReportStatusHistory[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([category])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([status, priority])
  @@index([duplicateOfId])
  @@map("bug_reports")
}

