/// Per-billed-run analytics log (tool / agent / workforce / swarm / chat).
/// One row per successful ExecutionCharge (same billingKey).
model ExecutionLog {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  billingKey String  @unique @map("billing_key")
  kind       String // composite_tool | workforce | agent | swarm | chat
  status     String  @default("STARTED") // STARTED | SUCCEEDED | FAILED | CANCELLED
  runId      String? @map("run_id")
  label      String?

  toolId         String? @map("tool_id")
  toolName       String? @map("tool_name")
  agentId        String? @map("agent_id")
  agentName      String? @map("agent_name")
  workforceId    String? @map("workforce_id")
  workforceName  String? @map("workforce_name")
  conversationId String? @map("conversation_id")
  workspaceId    String? @map("workspace_id")
  spaceId        String? @map("space_id")

  durationMs   Int?    @map("duration_ms")
  errorMessage String? @map("error_message") @db.Text
  metadata     Json?

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([toolId])
  @@index([agentId])
  @@index([workforceId])
  @@map("execution_logs")
}

