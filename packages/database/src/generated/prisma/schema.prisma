model CompositeTool {
  id             String           @id @default(cuid())
  workspaceId    String?          @map("workspace_id")
  spaceId        String?          @map("space_id")
  projectId      String?          @map("project_id")
  teamId         String?          @map("team_id")
  ownerId        String           @map("owner_id")
  name           String
  avatar         String?
  icon           String?
  color          String?
  description    String?
  systemPrompt   String?          @map("system_prompt")
  category       String?
  functionSchema Json
  steps          Json
  mode           ToolCreationMode @default(MANUAL)
  isPublic       Boolean          @default(true) @map("is_public")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  workspace       Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  space           Space?                      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  project         Project?                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team            Team?                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  aiConversations AiConversation[]
  versions        CompositeToolVersion[]
  executionLogs   CompositeToolExecutionLog[]

  // soft delete — for consistency with User and audit trail integrity
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  @@index([workspaceId])
  @@index([spaceId])
  @@index([projectId])
  @@index([teamId])
  @@index([ownerId])
  @@index([ownerId, createdAt]) // "my tools, newest first"
  @@index([isPublic, category]) // public marketplace browsing by category
  @@index([createdAt]) // global recency sort
  @@index([deletedAt])
  @@map("composite_tools")
}

model CompositeToolVersion {
  id              String   @id @default(cuid())
  compositeToolId String   @map("composite_tool_id")
  version         Int
  name            String?
  description     String?
  functionSchema  Json
  steps           Json
  isLive          Boolean  @default(false) @map("is_live")
  createdAt       DateTime @default(now()) @map("created_at")
  createdById     String   @map("created_by_id")

  compositeTool CompositeTool @relation(fields: [compositeToolId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)

  executionLogs CompositeToolExecutionLog[]

  @@unique([compositeToolId, version]) // prevent duplicate version numbers
  @@index([compositeToolId, isLive]) // fast "get live version" lookup
  @@index([createdById])
  @@map("composite_tool_versions")
}

// In a migration (Prisma doesn't support partial unique indexes natively):
// CREATE UNIQUE INDEX one_live_version_per_tool
//   ON composite_tool_versions (composite_tool_id)
//   WHERE is_live = true;

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  CANCELLED
}

model CompositeToolExecutionLog {
  id              String          @id @default(cuid())
  compositeToolId String          @map("composite_tool_id")
  versionId       String?         @map("version_id")
  userId          String?         @map("user_id")
  status          ExecutionStatus @default(PENDING)
  input           Json?
  output          Json?
  steps           Json?
  error           String?
  executionTimeMs Int?            @map("execution_time_ms")
  createdAt       DateTime        @default(now()) @map("created_at")
  finishedAt      DateTime?       @map("finished_at")

  compositeTool CompositeTool         @relation(fields: [compositeToolId], references: [id], onDelete: Cascade)
  version       CompositeToolVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([compositeToolId, createdAt]) // tool's execution history, time-ordered
  @@index([versionId])
  @@index([userId, createdAt])
  @@index([status]) // dashboards filtering failed/pending runs
  @@map("composite_tool_execution_logs")
}

/// Idempotency store for Inngest composite tool step execution.
/// Key format: "{runId}:{stepId}"  — one record per step per run attempt.
/// Ensures Inngest retries never re-execute side-effectful steps (DB writes,
/// emails, Stripe charges) and never return large payloads through Inngest
/// step output (result is read from here on retry).
model ToolStepResult {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @map("idempotency_key")
  toolId         String   @map("tool_id")
  runId          String   @map("run_id")
  stepId         String   @map("step_id")
  stepName       String?  @map("step_name")
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([runId]) // look up all steps for a given run
  @@index([toolId, runId]) // per-tool run history
  @@map("tool_step_results")
}

