# Agentflox — Deep Integrations environment variables
#
# Copy the relevant sections into:
#   apps/backend/.env
#   apps/frontend/.env.local
#
# Full per-app templates:
#   apps/backend/.env.integrations.example
#   apps/frontend/.env.integrations.example
#
# Generate vault encryption key:
#   openssl rand -hex 32

# ── Backend (apps/backend/.env) ─────────────────────────────────────────────
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret
GOOGLE_CLIENT_ID=your-google-cloud-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-cloud-oauth-client-secret
GOOGLE_INTEGRATION_PUBLIC=false
GOOGLE_INTEGRATION_TEST_USER_IDS=

# ── Frontend (apps/frontend/.env or .env.local) ───────────────────────────────
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3002
NEXT_PUBLIC_INTEGRATIONS_V2=true

# Login and integration connect share the same OAuth callbacks:
#   {AUTH_URL}/api/auth/callback/google|github|slack

# ── Deploy commands (run once per environment) ────────────────────────────────
# pnpm --filter @agentflox/backend integrations:sync-tools
# pnpm --filter @agentflox/backend integrations:migrate-triggers
