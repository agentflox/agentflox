# Deep Integrations — copy into apps/frontend/.env.local
# OAuth client IDs/secrets are shared with backend (same Google/GitHub/Slack apps).

# ── Auth base URL (must match the origin users open in the browser) ───────────
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Authorized redirect URIs (same as login — do not add a second GitHub URL) ─
# Integrations reuse the existing NextAuth callbacks:
#   http://localhost:3000/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/slack
#
# Open the app on the same host you registered (localhost vs 127.0.0.1 must match).
#
# Popup completion page (no console registration needed):
#   /auth/oauth-popup-complete

GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret

GOOGLE_CLIENT_ID=your-google-cloud-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-cloud-oauth-client-secret

# ── Backend API (for vault sync + tool sync) ─────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3002

# ── Feature flag (set to false to disable new Integrations UI) ───────────────
NEXT_PUBLIC_INTEGRATIONS_V2=true
