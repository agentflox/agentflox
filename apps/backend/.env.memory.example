# Agent Memory (ClickUp-style document notebook dual-write)
# Default on when unset. Set to false to disable ensure-doc / View memories / doc dual-write.
AGENT_MEMORY_DOC_V1=true
NEXT_PUBLIC_AGENT_MEMORY_DOC_V1=true

# Optional sibling flag for the daily memory reaper (indexes still apply separately)
AGENT_MEMORY_REAPER_V1=true
