# Shared Model Manager — platform provider keys
# Copy these into apps/backend/.env (and apps/frontend/.env if needed) and replace placeholders.

# OpenAI (system models: GPT-*, o-series)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (system models: Claude *)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini (system models: Gemini *)
GOOGLE_API_KEY=AIzaSy-your-google-gemini-api-key-here
GEMINI_API_KEY=AIzaSy-your-google-gemini-api-key-here

# AES-256-GCM key for encrypting custom/BYOK model credentials at rest
# Use a long random string (32+ characters). Rotate by re-encrypting stored credentials.
MODEL_CREDENTIALS_ENCRYPTION_KEY=replace-with-32+-char-secret-for-byok-encryption

# Deep integrations (OAuth vault, Slack, Google scopes) — see .env.integrations.example
# INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output
